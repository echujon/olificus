---
permalink: /comic/
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comics - Olificus</title>
    <style>
        @font-face {
            font-family: 'Comic Neue';
            src: url('/fonts/ComicNeue-Regular.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Comic Neue', system-ui, -apple-system, sans-serif;
        }

        .comics-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        h1 {
            text-align: center;
        }

        .comic-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.5rem;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .comic-list li a {
            display: block;
            text-decoration: none;
            color: inherit;
            transition: transform 0.2s;
        }

        .comic-list li a:hover {
            transform: scale(1.03);
        }

        .comic-list img {
            width: 100%;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            display: block;
        }

        .comic-list h2 {
            font-size: 1rem;
            margin: 0.5rem 0 0;
            text-align: center;
        }
    </style>
</head>
<body>
    {% include "navbar.njk" %}
    <div class="comics-container">
        <h1>Comics</h1>
        <ul class="comic-list">
            {% for comic in collections.comic %}
            <li>
                <a href="{{ comic.url }}">
                    {% if comic.data.preview_image %}
                        <img src="{{ comic.data.preview_image }}" alt="{{ comic.data.title }}">
                    {% endif %}
                    <h2>{{ comic.data.slug | episodeLabel }}: {{ comic.data.title }}</h2>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% include "footer.njk" %}
</body>
</html>
